# Optional live public-web enrichment for production GTM skills.
# Copy to .env locally. Never commit the copied file or put the token in a prompt.
APIFY_ENABLED=false
APIFY_TOKEN=

# Keep the default actor set narrow and review any actor before adding it.
APIFY_ALLOWED_ACTORS=apify/rag-web-browser,apify/e-commerce-scraping-tool,apify/google-search-scraper,apify/website-content-crawler
APIFY_WAIT_FOR_FINISH_SECS=60
APIFY_MAX_TOTAL_CHARGE_USD=0.25
APIFY_MAX_ITEMS=10

# Optional localization for the search operation.
# APIFY_SEARCH_COUNTRY=ro
# APIFY_SEARCH_LANGUAGE=ro
# APIFY_SEARCH_INTERFACE_LANGUAGE=ro
